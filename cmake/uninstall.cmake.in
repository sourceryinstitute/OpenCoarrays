# Adapted from http://www.cmake.org/Wiki/CMake_FAQ#Can_I_do_.22make_uninstall.22_with_CMake.3F May 1, 2014

if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt")
endif(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\n" ";" files "${files}")
foreach(file IN LISTS files)
  if(IS_SYMLINK "$ENV{DESTDIR}${file}")
    message(STATUS "$ENV{DESTDIR}${file} is a symbolic link.")
  elseif(EXISTS "$ENV{DESTDIR}${file}")
    file(SHA256 "$ENV{DESTDIR}${file}" sha256)
    message(STATUS "${sha256}  $ENV{DESTDIR}${file}")
  else()
    message(STATUS "File $ENV{DESTDIR}${file} does not exist.")
  endif()
endforeach()
foreach(file IN LISTS files)
  if(IS_SYMLINK "$ENV{DESTDIR}${file}" OR EXISTS "$ENV{DESTDIR}${file}")
    message(STATUS "Uninstalling $ENV{DESTDIR}${file}")
    file(REMOVE "$ENV{DESTDIR}${file}")
  else()
    message(STATUS "File $ENV{DESTDIR}${file} does not exist.")
  endif()
endforeach()

# Remove the directories that only OpenCoarrays installs into, once they are empty.
# Match them by their path below the install prefix, which `cmake --install --prefix`
# may have changed from the configured one. Shared directories, such as `bin`, stay.
set(own_dirs_regex "")
foreach(own_dir IN ITEMS
    "@CMAKE_INSTALL_INCLUDEDIR@/@mod_dir_tail@"
    "@CMAKE_INSTALL_LIBDIR@/cmake/opencoarrays"
    "@CMAKE_INSTALL_DATADIR@/@PROJECT_NAME@")
  # Escape every regex metacharacter, such as the dots in version numbers
  string(REGEX REPLACE "([][^$.*+?|()\\])" "\\\\\\1" own_dir "${own_dir}")
  list(APPEND own_dirs_regex "${own_dir}")
endforeach()
list(JOIN own_dirs_regex "|" own_dirs_regex)
set(dirs "")
foreach(file IN LISTS files)
  get_filename_component(dir "${file}" DIRECTORY)
  if(dir MATCHES "(^|/)(${own_dirs_regex})$")
    list(APPEND dirs "${dir}")
  endif()
endforeach()
list(REMOVE_DUPLICATES dirs)
foreach(dir IN LISTS dirs)
  if(IS_DIRECTORY "$ENV{DESTDIR}${dir}")
    file(GLOB entries "$ENV{DESTDIR}${dir}/*")
    if(entries)
      message(STATUS "Keeping $ENV{DESTDIR}${dir}: it is not empty.")
    else()
      message(STATUS "Removing empty directory $ENV{DESTDIR}${dir}")
      file(REMOVE_RECURSE "$ENV{DESTDIR}${dir}")
    endif()
  endif()
endforeach()
